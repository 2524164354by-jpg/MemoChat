<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/date_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_date_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textColor="#999999"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/backfill_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="2dp"
        android:paddingHorizontal="6dp"
        android:paddingVertical="1dp"
        android:text="补发"
        android:textColor="#B0B0B0"
        android:textSize="10sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:background="@drawable/bubble_green"
            android:gravity="start"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="#111111"
            android:textSize="16sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/image"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_msg_image"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <View
        android:id="@+id/edited_dot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_gravity="end"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_dot_blue"
        android:visibility="gone" />
</LinearLayout>
