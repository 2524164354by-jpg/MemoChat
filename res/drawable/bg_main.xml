<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base light gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E8F0FF"
                android:centerColor="#F0EBFF"
                android:endColor="#E6FFF2" />
        </shape>
    </item>

    <!-- Green halo top-left -->
    <item
        android:width="400dp"
        android:height="400dp"
        android:gravity="top|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#5507C160"
                android:endColor="#0007C160" />
        </shape>
    </item>

    <!-- Blue halo top-right -->
    <item
        android:width="380dp"
        android:height="380dp"
        android:gravity="top|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:startColor="#555B8DEF"
                android:endColor="#005B8DEF" />
        </shape>
    </item>

    <!-- Purple halo bottom-left -->
    <item
        android:width="400dp"
        android:height="400dp"
        android:gravity="bottom|start">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:startColor="#4D8E7CF0"
                android:endColor="#008E7CF0" />
        </shape>
    </item>

    <!-- Orange halo bottom-right -->
    <item
        android:width="340dp"
        android:height="340dp"
        android:gravity="bottom|end">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:startColor="#40FF9F40"
                android:endColor="#00FF9F40" />
        </shape>
    </item>

</layer-list>
